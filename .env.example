# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo ".env" nunca deve ser commitado no git (já está no .gitignore).

# Conta usada para autenticar e enviar os e-mails
EMAIL_USER=seu_email@outlook.com
EMAIL_PASS=sua_senha_ou_senha_de_app

# Serviço padrão do nodemailer (Outlook/Hotmail/Office365).
# Se a sua conta exigir autenticação moderna e o envio via "service" falhar,
# comente a linha acima e use um host SMTP explícito abaixo, por exemplo:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
EMAIL_SERVICE=Outlook

# Porta em que o servidor local vai rodar
PORT=3000

# Tamanho de cada lote de BCC e intervalo (ms) entre lotes,
# para reduzir o risco de bloqueio/throttling pelo provedor.
BATCH_SIZE=90
BATCH_DELAY_MS=1500

# Modo de teste: não envia e-mails de verdade, só simula (bom para testar a UI)
# EMAIL_TRANSPORT=json
